# Backend Environment Variables
API_PORT=8000
DEBUG=False
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
WHISPER_MODEL=base
MAX_AUDIO_SIZE_MB=50
DATABASE_URL=sqlite:///./data/evolvs.db
JWT_SECRET=your-secret-key
JWT_ALGORITHM=HS256

# MCP remote Playwright orchestration
MCP_HOST=your.mcp.host.or.ip
MCP_USER=mcpuser
MCP_SSH_KEY=C:\Users\sg200\.ssh\id_rsa
REMOTE_PROJECT_PATH=/home/mcpuser/evolvs-ai
PLAYWRIGHT_CMD=cd /home/mcpuser/evolvs-ai && npm ci && npx playwright test --reporter=json > playwright_report.json
MCP_REPORT_PATH=playwright_report.json
SLACK_WEBHOOK=
